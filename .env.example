# ------------------------------------------------------------------
# Copia este archivo a .env (desarrollo). NUNCA subas .env al repo.
# En Vercel, define estas variables en Project Settings > Environment Variables.
# ------------------------------------------------------------------

# Conexión con el rol dueño del esquema. Solo para migraciones y scripts de administración.
# NO se configura en Vercel (la app en producción no la necesita).
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:54329/rally

# Conexión con el rol restringido "rally_app" (solo EXECUTE sobre funciones game.*).
# En Neon usa el endpoint "-pooler".
DATABASE_URL=postgres://rally_app:rally_app_dev@localhost:54329/rally

# Contraseña que el script de migración asigna al rol rally_app.
RALLY_APP_PASSWORD=rally_app_dev

# Secreto para HMAC de códigos de activación y sesiones (mínimo 32 caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_PEPPER=dev-only-pepper-change-me-0123456789abcdef

# Evento activo (slug) para el inicio de sesión del staff.
EVENT_SLUG=rally-dev

# Origen público de la web (CSRF + URLs de QR impresos).
APP_ORIGIN=http://localhost:5173

# true en producción (cookies Secure). false solo en desarrollo HTTP local.
COOKIE_SECURE=false
